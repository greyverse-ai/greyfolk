{
  "name": "greyfolk",
  "version": "0.1.0",
  "description": "One harness (soul + vessel + session) served as a plain OpenAI Responses-shaped server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "greyfolk": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
