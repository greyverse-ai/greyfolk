    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@openai/codex-sdk": "0.161.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
